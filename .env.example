# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dharana

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dharana-media
MINIO_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# OAuth-провайдеры (пусто — вход через провайдера отдаёт 501 NOT_CONFIGURED)
# Google: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_ANDROID_CLIENT_ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
# VK ID (https://id.vk.com)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Яндекс OAuth (https://oauth.yandex.ru)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Базовый URL сайта: из него сервер сам собирает redirect_uri
# ({base}/api/auth/{provider}/callback) — он должен совпадать с указанным
# в консоли провайдера.
OAUTH_REDIRECT_BASE_URL=https://dharana.ru
# Дополнительные redirect_uri (через запятую) для клиентов с не-вебовым колбэком:
# приложение Android ловит App Link и шлёт его сюда. Список должен совпадать
# с тем, что указано в консоли провайдера. Пусто = только колбэк сайта.
VK_ALLOWED_REDIRECT_URIS=
YANDEX_ALLOWED_REDIRECT_URIS=https://dharana.ru/app/auth/yandex/callback

# MAX (МАКС): отдельного OAuth нет — вход идёт через мини-приложение бота,
# которое присылает подписанный initData. Токен и username бота выдаёт
# партнёрская платформа MAX после верификации профиля.
MAX_BOT_TOKEN=
MAX_BOT_NAME=
# Служебный ключ бота для /auth/max/bot/* (заголовок X-Max-Bot-Key).
MAX_BOT_KEY=
# HTTPS-адрес мини-приложения входа (страница сайта).
MAX_MINIAPP_URL=https://dharana.ru/ru/max/login
# Секрет webhook MAX-бота: 5–256 символов A-Z a-z 0-9 _ -
MAX_WEBHOOK_SECRET=
# Срок жизни сессии входа, минуты.
MAX_SESSION_TTL_MINUTES=10
